#!/usr/bin/env python3
"""Codex (OpenAI) usage straight from the API, ~1 s. Reads the Codex CLI token in ~/.codex/auth.json.
The token is never printed.

Usage: codex-usage-fast [-v|--verbose]
  default       brief: one line; per window, % used, mini-bar with pace marker and time until the reset.
  -v, --verbose full: a bar per window, pace marker and reset time.
"""
import json, os, sys, urllib.request, datetime, pathlib

if any(a in ("-h", "--help") for a in sys.argv[1:]):
    print(__doc__.strip()); sys.exit(0)
BRIEF = not any(a in ("-v", "--verbose") for a in sys.argv[1:])
JSON = "--json" in sys.argv[1:]

def _tz():
    try:
        import zoneinfo
        conf = pathlib.Path(os.environ.get("CLAUDE_MULTICONTA_CONF",
                            pathlib.Path.home() / ".config/claude-multiconta/accounts.json"))
        name = "America/Sao_Paulo"
        if conf.exists():
            name = json.loads(conf.read_text()).get("timezone") or name
        return zoneinfo.ZoneInfo(name)
    except Exception:
        return None   # local time zone
TZ = _tz()
AUTH = pathlib.Path.home() / ".codex/auth.json"

def die(msg):
    print(msg, file=sys.stderr); sys.exit(1)

try:
    auth = json.loads(AUTH.read_text())
    t = auth["tokens"]
except Exception as e:
    if JSON: print(json.dumps({"err": "not logged in. Run: codex-login"})); sys.exit(0)
    if BRIEF: print(f"{'Codex':<10} ✗ not logged in. Run: codex-login")
    else:     print(f"\n📊 Codex\n   ✗ not logged in ({AUTH} does not exist). Run: codex-login\n")
    sys.exit(2)

req = urllib.request.Request(
    "https://chatgpt.com/backend-api/wham/usage",
    headers={"Authorization": f"Bearer {t['access_token']}",
             "ChatGPT-Account-ID": t["account_id"],
             "Accept": "application/json", "User-Agent": "codex-cli"})
try:
    with urllib.request.urlopen(req, timeout=15) as resp:
        d = json.load(resp)
except urllib.error.HTTPError as e:
    if e.code in (401, 403):
        die("Codex token expired or invalid. Open `codex` once (it renews the token) or run `codex-login`.")
    die(f"API answered {e.code}: {e.read().decode()[:300]}")


# ---- bar with pace marker (CodexBar style) ------------------------------
BAR_W = 20
COLOR = sys.stdout.isatty()
def c(code, s): return f"\033[{code}m{s}\033[0m" if COLOR else s

def bar(p, pace=None):
    """p = % used; pace = % of the window already elapsed (where the bar 'should' be)."""
    p = max(0.0, min(100.0, float(p or 0)))
    n = int(round(p / 100 * BAR_W))
    cells = ["█"] * n + ["░"] * (BAR_W - n)
    if pace is not None:
        i = min(BAR_W - 1, int(pace / 100 * BAR_W))
        cells[i] = c("1;33", "┃")
    return "".join(cells)

def pace_info(p, pace):
    """Text for the deviation from the expected pace."""
    if pace is None: return ""
    d = (p or 0) - pace
    if abs(d) < 3:  s = c("32", "on pace")
    elif d > 0:     s = c("31" if d >= 15 else "33", f"▲{d:+.0f} above pace")
    else:           s = c("32", f"▼{d:+.0f} below pace")
    return f"  pace {pace:3.0f}% ({s})"

def pace_for(w):
    win = w.get("limit_window_seconds") or 0
    rem = w.get("reset_after_seconds")
    if rem is None and w.get("reset_at"):
        rem = w["reset_at"] - datetime.datetime.now().timestamp()
    if not win or rem is None or rem <= 0 or rem > win: return None
    return 100 * (1 - rem / win)

def fmt_reset(ts):
    if not ts: return ""
    return datetime.datetime.fromtimestamp(ts, TZ).strftime("%d/%m %H:%M")

def fmt_left(secs, win=None):
    """Time until the reset, fixed width: 00h45, 04h45, 6d03h.
    Window not started: the full duration (win) in grey, since the clock only starts on first use."""
    if secs is None: return c("2", fmt_left(win)) if win else "  —  "
    secs = max(0, int(secs)); d, r = divmod(secs, 86400); h, m = divmod(r // 60, 60)
    return f"{d}d{h:02d}h" if d else f"{h:02d}h{m:02d}"

def left_w(w):
    rem = w.get("reset_after_seconds")
    if rem is None and w.get("reset_at"):
        rem = w["reset_at"] - datetime.datetime.now().timestamp()
    return rem

LABEL_W, CELL_BAR, SEP = 10, 10, "  "
LEGEND = ["█ used  ┃ pace (how much of the window has passed)  on the right: time left until the reset",
          "green = below pace · yellow = above · red = 15+ points above"]
def print_legend():
    if os.environ.get("USAGE_NO_LEGEND"): return
    for l in LEGEND: print(c("2", l))

def print_header(titles):
    """Window names centred over each column (dim)."""
    if os.environ.get("USAGE_NO_LEGEND") or not titles: return
    print(c("2", (" " * (LABEL_W + 1) + SEP.join(f"{t:^{CELL_BAR + 11}}" for t in titles)).rstrip()))

def cell(p, pace, secs, win):
    """One window of the brief view, 21 columns: ' 32% ███████┃░░ 2d02h'.
    Bar = used (green/yellow/red by the deviation from the pace); ┃ = pace; then, time left until the reset."""
    pi = int(round(p))
    n = int(round(max(0.0, min(100.0, float(p))) / 100 * CELL_BAR))
    col = None
    if pace is not None:
        d = pi - int(round(pace))
        col = "31" if d >= 15 else "33" if d > 0 else "32"
    cells = [c(col, "█") if col else "█"] * n + [c("2", "░")] * (CELL_BAR - n)
    if pace is not None:
        i = min(CELL_BAR - 1, int(pace / 100 * CELL_BAR))
        cells[i] = c(f"1;{col}", "┃") if i < n else c("1", "┃")   # inside the bar: a notch in the bar's colour
    pct = f"{pi:3d}%"
    return f"{c(col, pct) if col else pct} {''.join(cells)} {fmt_left(secs, win)}"

def brief_pace(secs, win):
    """% of the window elapsed, for the brief view: 0 if the window has not even started; None if the data is stale."""
    if secs is None or (win and secs > win): return 0.0
    if secs <= 0 or not win: return None
    return 100 * (1 - secs / win)

def brief_name(w):
    h = (w.get("limit_window_seconds") or 0) // 3600
    return f"{h}h" if h < 48 else f"{h // 24}d"

def win_name(w):
    h = (w.get("limit_window_seconds") or 0) // 3600
    return f"⏱  Session {h}h" if h < 48 else f"📅 Weekly {h // 24}d (all)"

rl = d.get("rate_limit") or {}
if JSON:
    out = {}
    for key in ("primary_window", "secondary_window"):
        w = rl.get(key)
        if not w: continue
        k = brief_name(w)
        out[k] = float(w.get("used_percent") or 0)
        out[k + "_pace"] = round(brief_pace(left_w(w), w.get("limit_window_seconds")) or 0.0, 1)
        out[k + "_left"] = None if left_w(w) is None else max(0, int(left_w(w)))
    print(json.dumps(out)); sys.exit(0)
if BRIEF:
    cells, titles = [], []
    for key in ("primary_window", "secondary_window"):
        w = rl.get(key)
        if not w: continue
        p = float(w.get("used_percent") or 0)
        secs, win = left_w(w), w.get("limit_window_seconds")
        cells.append(cell(p, brief_pace(secs, win), secs, win))
        h = (win or 0) // 3600
        titles.append(f"session {h}h" if h < 48 else f"week {h // 24}d")
    if rl.get("limit_reached"): cells.append(c("31", "⚠️ limit reached"))
    print_legend(); print_header(titles)
    print(f"{'Codex':<{LABEL_W}} " + SEP.join(cells))
    sys.exit(0)

now = datetime.datetime.now(TZ).strftime("%d/%m %H:%M")
plan = (d.get("plan_type") or "?").capitalize()
print(f"\n📊 Codex — {d.get('email', '?')} ({plan} plan) — {now}   (┃ = where the bar should be to stay on pace)\n")
for key in ("primary_window", "secondary_window"):
    w = rl.get(key)
    if not w: continue
    p = w.get("used_percent") or 0
    pace = pace_for(w)
    print(f"{win_name(w):<22} {p:>3.0f}% [{bar(p, pace)}]  resets {fmt_reset(w.get('reset_at'))}{pace_info(p, pace)}")
if rl.get("limit_reached"):
    print("\n⚠️  Limit reached.")
cr = d.get("credits") or {}
if cr.get("has_credits"):
    print(f"\n💳 Extra credits: {cr.get('balance')}")
rc = d.get("rate_limit_reset_credits") or {}
if rc.get("available_count"):
    print(f"🔄 Limit resets available: {rc['available_count']}")
print()
