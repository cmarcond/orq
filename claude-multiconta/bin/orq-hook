#!/usr/bin/env python3
"""The orq hook. On each agent event:
  - writes the state to $ORQ_STATE/state.json (read by `orq --status-json` and by the web page);
  - when the agent stops or asks for something, sends an iTerm2 notification (OSC 9) through the pane's terminal.

It only acts in sessions opened by orq-run, which sets:
  ORQ_TTY    the pane's terminal (hooks run without a terminal of their own)
  ORQ_DEPTH  how many tmux layers the alert has to cross to reach iTerm2
  ORQ_LABEL  short name of the project, e.g.: myproject@server0
  ORQ_STATE  state folder of this pane
"""
import json, os, sys, time

if not os.environ.get("ORQ_LABEL"):
    sys.exit(0)
try:
    ev = json.load(sys.stdin)
except Exception:
    ev = {}
label = os.environ["ORQ_LABEL"]
name = ev.get("hook_event_name")

STATES = {   # event -> (state, alert message or None)
    "SessionStart":     ("waiting", None),
    "UserPromptSubmit": ("working", None),
    "Stop":             ("waiting", "finished, your turn"),
    "Notification":     ("permission", ev.get("message") or "needs you"),
    "StopFailure":      ("error", "stopped with an error (quota?). /exit switches account"),
    "SessionEnd":       ("closed", None),
}
if name not in STATES:
    sys.exit(0)
state, alert = STATES[name]
if name == "Notification" and "waiting for your input" in (ev.get("message") or ""):
    state = "waiting"           # idle notice, not a permission request

sd = os.environ.get("ORQ_STATE")
if sd:
    f = os.path.join(sd, "state.json")
    try:
        cur = json.load(open(f))
    except Exception:
        cur = {}
    cur.update(label=label, state=state, event=name, ts=time.time(),
               sid=ev.get("session_id") or cur.get("sid"), msg=alert or "")
    try:
        tmp = f + ".tmp"
        json.dump(cur, open(tmp, "w")); os.replace(tmp, f)
    except Exception:
        pass

tty = os.environ.get("ORQ_TTY")
if alert and tty:
    msg = f"{label}: {alert}".replace("\x07", " ").replace("\x1b", " ")[:200]
    seq = f"\x1b]9;{msg}\x07"
    for _ in range(int(os.environ.get("ORQ_DEPTH", "0") or 0)):   # passthrough for each tmux layer
        seq = "\x1bPtmux;" + seq.replace("\x1b", "\x1b\x1b") + "\x1b\\"
    try:
        with open(tty, "w") as t:
            t.write(seq)
    except Exception:
        pass
sys.exit(0)
