#!/usr/bin/env python3
"""Which account had the most recent conversation in a folder (for --resume).

Usage: claude-last [-a|--all] [folder]     (no folder = the current one)
  default       the most recent conversation of each account, newest first
  -a, --all     the 15 most recent conversations, from any account
  --pick [N]    only prints "account id" of line N (default 1); used by the claude-resume function
  --as ACCOUNT  with --pick: copies the conversation to ACCOUNT (if it belongs to another) and prints "ACCOUNT id"
  --projects    JSON with the most recent conversation of each folder on this machine, in any account (used by orq)

To open it on the right account: claude-resume (the most recent) or claude-resume N (line N).
claude-resume -a N uses the numbering of claude-last -a.
To resume using another account (e.g.: the original one ran out of quota): claude-resume --as gmail [N].
"""
import json, os, re, sys, pathlib, datetime

CONF = pathlib.Path(os.environ.get("CLAUDE_MULTICONTA_CONF",
                    pathlib.Path.home() / ".config/claude-multiconta/accounts.json"))
args = sys.argv[1:]
if any(a in ("-h", "--help") for a in args):
    print(__doc__.strip()); sys.exit(0)
AS = None
for i, a in enumerate(list(args)):
    if a.startswith("--as="): AS = a.split("=", 1)[1]
    elif a == "--as" and i + 1 < len(args): AS = args[i + 1]; args[i + 1] = "-"   # consumes the value
PICK = "--pick" in args
ALL = any(a in ("-a", "--all") for a in args)
rest = [a for a in args if not a.startswith("-")]
N = 1
if rest and rest[0].isdigit():
    N = int(rest.pop(0))
folder = pathlib.Path(rest[0] if rest else os.getcwd()).expanduser().resolve()

try:
    conf = json.loads(CONF.read_text())
except Exception as e:
    print(f"Could not read {CONF} ({e}). Run the claude-multiconta install.sh.", file=sys.stderr); sys.exit(1)

COLOR = sys.stdout.isatty()
STATE_DIR = pathlib.Path(os.environ.get("ORQ_STATE_DIR", pathlib.Path.home() / ".cache/orq"))

def orq_sids():
    """Conversations of the page's agents (orq-web), from each one's state.json: sid -> is it an upper level?
    They run as `claude -p` (entrypoint sdk-cli), just like scripts, but they are real conversations;
    the one of a level (professor etc.), however, must not be resumed as if it were the project's."""
    out = {}
    for f in STATE_DIR.glob("*/state.json"):
        try: st = json.loads(f.read_text())
        except Exception: continue
        if st.get("sid"): out[st["sid"]] = bool(st.get("parent"))
    return out
ORQ = orq_sids()
def c(code, s): return f"\033[{code}m{s}\033[0m" if COLOR else s

def project_dir(cfg):
    """Project folder inside the config_dir: Claude Code replaces every non-alphanumeric character with '-'.
    Very long paths are truncated with a suffix; in that case it searches by the prefix."""
    enc = re.sub(r"[^a-zA-Z0-9]", "-", str(folder))
    base = cfg / "projects"
    if (base / enc).is_dir(): return [base / enc]
    if len(enc) > 200 and base.is_dir():
        return [d for d in base.iterdir() if d.is_dir() and d.name.startswith(enc[:200])]
    return []

NOISE = {"responda apenas: ok"}   # token-renewal requests from usage-all (the literal prompt usage-all sends)

def info(f):
    """Title (ai-title), otherwise the user's first prompt. None = conversation to hide."""
    title = first = last = None
    try:
        with open(f, encoding="utf-8", errors="ignore") as fh:
            for line in fh:
                if '"ai-title"' in line or '"last-prompt"' in line or (first is None and '"type":"user"' in line):
                    try: o = json.loads(line)
                    except Exception: continue
                    t = o.get("type")
                    if t == "ai-title" and o.get("aiTitle"): title = o["aiTitle"]
                    elif t == "last-prompt" and o.get("lastPrompt"): last = o["lastPrompt"]
                    elif t == "user" and first is None and (o.get("origin") or {}).get("kind") == "peer":
                        first = (o.get("origin") or {}).get("body") or None   # task that came from another session (upper level)
                    elif t == "user" and first is None and not o.get("isMeta"):
                        m = (o.get("message") or {}).get("content")
                        if isinstance(m, list):
                            m = " ".join(x.get("text", "") for x in m if isinstance(x, dict) and x.get("type") == "text")
                        if isinstance(m, str) and m.strip() and not m.lstrip().startswith("<"):
                            first = m
    except Exception:
        return ""
    prompts = {x.strip() for x in (first, last) if x}
    if prompts and prompts <= NOISE: return None   # even if it got an automatic title
    if not (title or first or last): return None   # empty conversation: it cannot be resumed
    return (title or first or last).replace("\n", " ").strip()

def ago(ts):
    s = int(datetime.datetime.now().timestamp() - ts)
    if s < 3600:   return f"{max(1, s // 60)}min"
    if s < 86400:  return f"{s // 3600}h"
    return f"{s // 86400}d"

def conv_meta(f):
    """(real folder, entrypoint) of the conversation. entrypoint 'cli' = interactive; 'sdk-cli' = claude -p from a script."""
    cwd = ep = None
    try:
        with open(f, encoding="utf-8", errors="ignore") as fh:
            for i, line in enumerate(fh):
                if '"cwd"' in line and '"entrypoint"' in line:
                    try:
                        o = json.loads(line); return o.get("cwd"), o.get("entrypoint")
                    except Exception: pass
                elif '"cwd"' in line and cwd is None:
                    try: cwd = json.loads(line).get("cwd")
                    except Exception: pass
                if i > 400: break
    except Exception:
        pass
    return cwd, ep

if "--projects" in args:
    best = {}    # cwd -> most recent record
    home = str(pathlib.Path.home())
    for a in conf.get("accounts", []):
        cfg = pathlib.Path(os.path.expanduser(a.get("config_dir") or "~/.claude"))
        base = cfg / "projects"
        if not base.is_dir(): continue
        for d in base.iterdir():
            if not d.is_dir(): continue
            files = sorted(d.glob("*.jsonl"), key=lambda f: f.stat().st_mtime, reverse=True)[:6]
            for f in files:            # the most recent interactive one, neither empty nor a token renewal
                if ORQ.get(f.stem): continue             # conversation of a level (professor) of the page
                cwd, ep = conv_meta(f)
                if ep and ep != "cli" and f.stem not in ORQ: continue   # claude -p from a script/cron
                if not cwd or cwd == home or not os.path.isdir(cwd): break
                if re.match(r"^(/private)?/tmp(/|$)", cwd): break
                t = info(f)
                if t is None: continue
                m = f.stat().st_mtime
                if cwd not in best or m > best[cwd]["mtime"]:
                    best[cwd] = {"cwd": cwd, "account": a["name"], "sid": f.stem, "mtime": m, "title": t}
                break
    out = sorted(best.values(), key=lambda r: -r["mtime"])[:40]
    print(json.dumps(out, ensure_ascii=False)); sys.exit(0)

rows = []   # (mtime, account, label, sessionId, file)
for a in conf.get("accounts", []):
    cfg = pathlib.Path(os.path.expanduser(a.get("config_dir") or "~/.claude"))
    for d in project_dir(cfg):
        for f in d.glob("*.jsonl"):
            if ORQ.get(f.stem): continue   # level of the page: it is not the project's conversation
            try: m = f.stat().st_mtime
            except OSError: continue
            rows.append((m, a["name"], a.get("label", a["name"]).split(" (")[0], f.stem, f))
rows.sort(reverse=True)

def filtered():
    """Hides empty and token-renewal conversations; appends the title."""
    for r in rows:
        t = info(r[4])
        if t is None: continue
        yield r + (t,)

def copy_to(target, f, sid, src):
    """Copies the conversation (and its attachments, and whatever project memory is missing) to the target account.
    A different earlier copy in the destination account becomes <id>.jsonl.bak-<date>, nothing is lost."""
    import shutil
    acc = {a["name"]: a for a in conf.get("accounts", [])}
    if target not in acc:
        print(f"unknown account: {target}. Available: {', '.join(acc)}", file=sys.stderr); sys.exit(1)
    cfg = pathlib.Path(os.path.expanduser(acc[target].get("config_dir") or "~/.claude"))
    dst_dir = cfg / "projects" / f.parent.name
    dst_dir.mkdir(parents=True, exist_ok=True)
    dst = dst_dir / f.name
    if dst.exists():
        if dst.read_bytes() == f.read_bytes():
            print(f"(the conversation was already in the {target} account)", file=sys.stderr); return target
        bak = dst.with_name(f"{dst.name}.bak-{datetime.datetime.now():%Y%m%d-%H%M%S}")
        dst.rename(bak)
        print(f"(the old copy in the {target} account was kept as {bak.name})", file=sys.stderr)
    shutil.copy2(f, dst)
    side = f.parent / sid               # the conversation's subagents and attachments, when they exist
    if side.is_dir() and not (dst_dir / sid).exists():
        shutil.copytree(side, dst_dir / sid)
    mem, n = f.parent / "memory", 0     # project memory: only the files missing at the destination
    if mem.is_dir():
        for x in mem.rglob("*"):
            y = dst_dir / "memory" / x.relative_to(mem)
            if x.is_file() and not y.exists():
                y.parent.mkdir(parents=True, exist_ok=True); shutil.copy2(x, y); n += 1
    print(f"copied from {src} to {target}" + (f" (+{n} memory file(s))" if n else "")
          + ". The original stays untouched.", file=sys.stderr)
    return target

out = []
seen = set()
for r in filtered():
    if not ALL:   # only the most recent of each account
        if r[1] in seen: continue
        seen.add(r[1])
    out.append(r)
    if len(out) >= (15 if ALL else len(conf.get("accounts", []))): break

if PICK:
    if len(out) < N:
        print(f"there is no conversation number {N} in {folder}", file=sys.stderr); sys.exit(1)
    m, name, lab, sid, f, t = out[N - 1]
    if AS and AS != name:
        name = copy_to(AS, f, sid, name)
    print(name, sid); sys.exit(0)

home = str(pathlib.Path.home())
show = str(folder).replace(home, "~", 1)
if not out:
    print(f"No Claude conversation in {show} in any account."); sys.exit(1)

print(c("2", f"{show}   (claude-resume N opens conversation N)"))
W = 52
for i, (m, name, lab, sid, f, t) in enumerate(out, 1):
    t = (t[:W - 1] + "…") if len(t) > W else t
    line = f"{i:>2}  {lab:<10} {ago(m):>5}  {t}"
    print(c("1", line) if i == 1 else line)
m, name, lab, sid, f, t = out[0]
print(c("2", f"    = claude-{name} --resume {sid}"))
