#!/usr/bin/env python3
"""Shows which account is in each config directory and which one plain `claude` opens.
Uses `claude auth status` (JSON) per account; it does not print tokens."""
import json, os, sys, subprocess, pathlib, shutil

CONF = pathlib.Path(os.environ.get("CLAUDE_MULTICONTA_CONF",
                    pathlib.Path.home() / ".config/claude-multiconta/accounts.json"))
try:
    conf = json.loads(CONF.read_text())
except Exception as e:
    sys.exit(f"Could not read {CONF} ({e}). Run the claude-multiconta install.sh.")

bin_ = shutil.which("claude") or str(pathlib.Path.home() / ".local/bin/claude")
default = conf.get("default_account")
rows = []
for a in conf["accounts"]:
    d = os.path.expanduser(a.get("config_dir") or "~/.claude")
    env = dict(os.environ)
    env.pop("CLAUDE_CONFIG_DIR", None)
    if pathlib.Path(d).resolve() != (pathlib.Path.home() / ".claude").resolve():
        env["CLAUDE_CONFIG_DIR"] = d
    try:
        out = subprocess.run([bin_, "auth", "status"], env=env, capture_output=True, text=True, timeout=30).stdout
        st = json.loads(out[out.index("{"):])
    except Exception:
        st = {}
    if st.get("loggedIn"):
        who = f"{st.get('email','?')}  ({st.get('subscriptionType','?')}, {st.get('orgName','?')})"
        ok = "✓"
    else:
        who = f"logged out — run claude-{a['name']}-login"
        ok = "✗"
    mark = "  ← plain `claude`" if a["name"] == default else ""
    rows.append((f"claude-{a['name']}", d.replace(str(pathlib.Path.home()), "~"), ok, who + mark))
w = max(len(r[0]) for r in rows)
print()
for cmd, d, ok, who in rows:
    print(f"  {cmd:<{w}}  {d:<18} {ok} {who}")
print()
