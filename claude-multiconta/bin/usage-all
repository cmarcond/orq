#!/usr/bin/env python3
"""usage-all: uso do Claude Code em todas as contas, direto na API OAuth (~1 s), com marcador de ritmo.

Uso: usage-all [-v|--verbose] [--json] [conta ...]     (sem conta = todas as contas do accounts.json)
  padrão         resumido: uma linha por conta; por janela, % usado, mini-barra com marcador de
                 ritmo e tempo até o reset. Contas ordenadas da mais folgada para a mais apertada no 7d.
  -v, --verbose  completo: barra por janela, marcador de ritmo, horário do reset e aviso de login.
  --json         para scripts (orq, orq-web): por conta, % usado, ritmo e segundos até o reset de
                 5h e 7d, ou {"err": texto}.

Ritmo = quanto da janela já passou. Barra que não chega no ┃ está abaixo do ritmo (verde); barra que
passa dele está acima (amarela; vermelha com 15 pontos ou mais). O Codex tem comando próprio:
codex-usage-fast.

Contas: ~/.config/claude-multiconta/accounts.json (ou $CLAUDE_MULTICONTA_CONF). Credencial: Keychain
no macOS (o mesmo item do Claude Code) ou <config_dir>/.credentials.json no Linux. O token nunca é
impresso. Python 3.8+.
"""
import argparse
import datetime
import hashlib
import json
import re
import os
import pathlib
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple

# ======================================================================== configuração
CONF = pathlib.Path(os.environ.get("CLAUDE_MULTICONTA_CONF", pathlib.Path.home() / ".config/claude-multiconta/accounts.json"))
DEFAULT_DIR = pathlib.Path.home() / ".claude"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
WINDOW = {"session": 5 * 3600, "weekly_all": 7 * 86400, "weekly_scoped": 7 * 86400}  # tamanho fixo de cada janela


def die(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    sys.exit(code)


def load_conf() -> dict:
    try:
        return json.loads(CONF.read_text())
    except Exception as e:  # noqa: BLE001
        die(f"Não consegui ler {CONF} ({e}). Rode o install.sh do claude-multiconta.")
        return {}


def timezone(conf: dict):
    try:
        import zoneinfo

        return zoneinfo.ZoneInfo(conf.get("timezone") or "America/Sao_Paulo")
    except Exception:  # noqa: BLE001  python < 3.9 ou sem tzdata: fuso local
        return None


@dataclass
class Account:
    name: str
    config_dir: pathlib.Path
    label: str  # curto: "Gmail"
    full_label: str  # como no accounts.json: "Gmail (you@example.com)"
    email: str

    @staticmethod
    def from_conf(a: dict) -> "Account":
        return Account(
            name=a["name"],
            config_dir=pathlib.Path(os.path.expanduser(a.get("config_dir") or "~/.claude")),
            label=(a.get("label") or a["name"]).split(" (")[0],
            full_label=a.get("label") or a["name"],
            email=a.get("email", ""),
        )

    @property
    def is_default(self) -> bool:
        return self.config_dir.resolve() == DEFAULT_DIR.resolve()

    @property
    def state_file(self) -> pathlib.Path:
        """Onde o Claude Code grava o login: ~/.claude.json para a conta padrão, <dir>/.claude.json nas outras."""
        return pathlib.Path.home() / ".claude.json" if self.is_default else self.config_dir / ".claude.json"


# ======================================================================== credencial e API
def keychain_service(acc: Account) -> str:
    """Nome do item no Keychain: 'Claude Code-credentials' para ~/.claude; as outras contas ganham o sufixo
    dos 8 primeiros hex do sha256 do caminho absoluto, como o Claude Code faz."""
    if acc.is_default:
        return "Claude Code-credentials"
    return "Claude Code-credentials-" + hashlib.sha256(str(acc.config_dir).encode()).hexdigest()[:8]


def load_cred(acc: Account) -> Optional[dict]:
    if sys.platform == "darwin":
        r = subprocess.run(["security", "find-generic-password", "-s", keychain_service(acc), "-w"], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return json.loads(r.stdout.strip())["claudeAiOauth"]
    f = acc.config_dir / ".credentials.json"
    if f.exists():
        return json.loads(f.read_text())["claudeAiOauth"]
    return None


def expired(cred: dict) -> bool:
    return cred.get("expiresAt", 0) / 1000 < datetime.datetime.now().timestamp()


def refresh_cred(acc: Account) -> Optional[dict]:
    """Token de acesso vencido (dura ~8 h): só o Claude Code renova, e só quando chama a API. Um pedido
    mínimo ao Haiku, sem gravar sessão, força a renovação; depois relemos a credencial."""
    claude = shutil.which("claude") or str(pathlib.Path.home() / ".local/bin/claude")
    env = dict(os.environ)
    env.pop("CLAUDE_CONFIG_DIR", None)
    if not acc.is_default:
        env["CLAUDE_CONFIG_DIR"] = str(acc.config_dir)
    try:
        subprocess.run(
            [claude, "-p", "responda apenas: ok", "--model", "haiku", "--no-session-persistence"],
            env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120, cwd=str(pathlib.Path.home()),
        )
    except Exception:  # noqa: BLE001
        return None
    return load_cred(acc)


def fetch_usage(cred: dict) -> dict:
    req = urllib.request.Request(
        USAGE_URL,
        headers={"Authorization": f"Bearer {cred['accessToken']}", "anthropic-beta": "oauth-2025-04-20", "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        return json.load(resp)


def logged_email(acc: Account) -> Optional[str]:
    try:
        return (json.loads(acc.state_file.read_text()).get("oauthAccount") or {}).get("emailAddress")
    except Exception:  # noqa: BLE001
        return None


# ======================================================================== modelo: janelas de uso
@dataclass
class Window:
    kind: str  # session | weekly_all | weekly_scoped
    percent: float
    resets_at: Optional[str]  # ISO-8601 ou None (janela ainda não iniciada)
    scope: Optional[str] = None  # nome do modelo, nas janelas por modelo
    severity: str = "normal"

    @property
    def size(self) -> Optional[int]:
        return WINDOW.get(self.kind)

    @property
    def left(self) -> Optional[float]:
        """Segundos até o reset; None se a janela não começou."""
        if not self.resets_at:
            return None
        end = datetime.datetime.fromisoformat(self.resets_at.replace("Z", "+00:00"))
        return (end - datetime.datetime.now(datetime.timezone.utc)).total_seconds()

    @property
    def pace(self) -> Optional[float]:
        """% da janela já decorrida: 0 se nem começou; None se o dado está vencido ou a janela é desconhecida."""
        secs, win = self.left, self.size
        if not win:
            return None
        if secs is None or secs > win:
            return 0.0
        if secs <= 0:
            return None
        return 100 * (1 - secs / win)

    @property
    def title(self) -> str:
        if self.scope:
            return f"{self.scope} 7d"
        return {"session": "sessão 5h", "weekly_all": "semana 7d"}.get(self.kind, self.kind)

    @property
    def long_title(self) -> str:
        t = {"session": "⏱  Sessão 5h", "weekly_all": "📅 Semanal 7d (todos)", "weekly_scoped": "🔮 Semanal 7d"}.get(self.kind, self.kind)
        return f"{t} só {self.scope}" if self.scope else t

    @property
    def slack(self) -> float:
        """Pontos acima (positivo) ou abaixo (negativo) do ritmo."""
        return self.percent - (self.pace or 0)


ORDER = {"session": 0, "weekly_all": 1, "weekly_scoped": 2}


def parse_windows(data: dict) -> List[Window]:
    limits = data.get("limits") or []
    if not limits:  # formato antigo da API
        limits = [
            {"kind": k, "percent": v.get("utilization"), "resets_at": v.get("resets_at")}
            for k, v in data.items()
            if isinstance(v, dict) and v.get("utilization") is not None
        ]
    out = []
    for lim in limits:
        out.append(
            Window(
                kind=lim.get("kind") or "?",
                percent=float(lim.get("percent") or 0),
                resets_at=lim.get("resets_at"),
                scope=((lim.get("scope") or {}).get("model") or {}).get("display_name"),
                severity=lim.get("severity", "normal"),
            )
        )
    return sorted(out, key=lambda w: ORDER.get(w.kind, 9))


def get_windows(acc: Account) -> Tuple[List[Window], Optional[str]]:
    """Janelas da conta, ou (None, erro curto)."""
    cred = load_cred(acc)
    if not cred:
        return [], f"sem credencial em {acc.config_dir}. Rode: claude-{acc.name}-login"
    if expired(cred):
        cred = refresh_cred(acc) or cred
        if expired(cred):
            return [], f"token expirado e não consegui renovar. Abra `claude-{acc.name}` uma vez ou rode claude-{acc.name}-login."
    try:
        return parse_windows(fetch_usage(cred)), None
    except urllib.error.HTTPError as e:
        return [], f"API respondeu {e.code}: {e.read().decode()[:200]}"
    except Exception as e:  # noqa: BLE001
        return [], f"falha de rede: {e}"


# ======================================================================== saída: formatação
COLOR = sys.stdout.isatty()


def c(code: Optional[str], s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if COLOR and code else s


def fmt_left(secs: Optional[float], win: Optional[int] = None) -> str:
    """Tempo até o reset em 5 colunas: 00h45, 04h45, 6d03h. Janela não iniciada: a duração cheia em cinza."""
    if secs is None:
        return c("2", fmt_left(win)) if win else "  —  "
    secs = max(0, int(secs))
    d, r = divmod(secs, 86400)
    h, m = divmod(r // 60, 60)
    return f"{d}d{h:02d}h" if d else f"{h:02d}h{m:02d}"


def color_for(percent: float, pace: Optional[float]) -> Optional[str]:
    """Verde abaixo do ritmo, amarelo acima, vermelho com 15 pontos ou mais acima; sem ritmo, sem cor."""
    if pace is None:
        return None
    d = int(round(percent)) - int(round(pace))
    return "31" if d >= 15 else "33" if d > 0 else "32"


# ---- resumido (padrão)
LABEL_W, CELL_BAR, SEP = 10, 10, "  "
LEGEND = [
    "█ usado  ┃ ritmo (quanto da janela já passou)  à direita: falta até o reset",
    "verde = abaixo do ritmo · amarelo = acima · vermelho = 15+ pontos acima",
    "TOTAL: semana da frota; à direita, quando zera (∞ = não zera com os resets); queima 1,0× = no ritmo",
]


def cell(w: Window) -> str:
    """Uma janela em 21 colunas: ' 32% ███████┃░░ 2d02h'. ┃ dentro da barra vira um entalhe na cor dela."""
    return cell_of(w.percent, w.pace, fmt_left(w.left, w.size))


def cell_of(percent: float, pace: Optional[float], right: str) -> str:
    col = color_for(percent, pace)
    n = int(round(max(0.0, min(100.0, percent)) / 100 * CELL_BAR))
    cells = [c(col, "█")] * n + [c("2", "░")] * (CELL_BAR - n)
    if pace is not None:
        i = min(CELL_BAR - 1, int(pace / 100 * CELL_BAR))
        cells[i] = c(f"1;{col}", "┃") if i < n else c("1", "┃")
    return f"{c(col, f'{int(round(percent)):3d}%')} {''.join(cells)} {right}"


def brief_row(acc: Account) -> Tuple[float, str, List[str], dict]:
    """(chave de ordenação, linha, títulos, json). Chave = folga no semanal de todos os modelos; erro vai para o fim."""
    windows, err = get_windows(acc)
    lab = f"{acc.label:<{LABEL_W}}"
    if err:
        return float("inf"), f"{lab} ✗ {err}", [], {"err": err}
    weekly = next((w.slack for w in windows if w.kind == "weekly_all"), 999.0)
    return weekly, f"{lab} " + SEP.join(cell(w) for w in windows), [w.title for w in windows], json_of(windows, None)


def show_brief(accounts: List[Account]) -> bool:
    with ThreadPoolExecutor(max_workers=8) as ex:
        rows = list(ex.map(brief_row, accounts))
    for line in LEGEND:
        print(c("2", line))
    titles = max((r[2] for r in rows), key=len, default=[])
    if titles:
        print(c("2", (" " * (LABEL_W + 1) + SEP.join(f"{t:^{CELL_BAR + 11}}" for t in titles)).rstrip()))
    for _, line, _, _ in sorted(rows, key=lambda r: r[0]):
        print(line)
    labels = {a.name: a.label for a in accounts}
    width = max((visible_len(r[1]) for r in rows), default=0)
    print()
    print(fmt_total(total_json({a.name: r[3] for a, r in zip(accounts, rows)}), labels, width))
    return all(r[0] != float("inf") for r in rows)


# ---- completo (-v)
BAR_W = 20


def bar(w: Window) -> str:
    n = int(round(max(0.0, min(100.0, w.percent)) / 100 * BAR_W))
    cells = ["█"] * n + ["░"] * (BAR_W - n)
    pace = w.pace if (w.pace or 0) > 0 else None
    if pace is not None:
        cells[min(BAR_W - 1, int(pace / 100 * BAR_W))] = c("1;33", "┃")
    return "".join(cells)


def pace_info(w: Window) -> str:
    pace = w.pace if (w.pace or 0) > 0 else None
    if pace is None:
        return ""
    d = w.percent - pace
    if abs(d) < 3:
        s = c("32", "no ritmo")
    elif d > 0:
        s = c("31" if d >= 15 else "33", f"▲{d:+.0f} acima do ritmo")
    else:
        s = c("32", f"▼{d:+.0f} abaixo do ritmo")
    return f"  ritmo {pace:3.0f}% ({s})"


def fmt_reset(iso: Optional[str], tz) -> str:
    if not iso:
        return ""
    return datetime.datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone(tz).strftime("%d/%m %H:%M")


def show_verbose(acc: Account, tz) -> Tuple[bool, dict]:
    windows, err = get_windows(acc)
    if err:
        print(f"\n📊 {acc.full_label}\n   ✗ {err}\n")
        return False, {"err": err}
    now = datetime.datetime.now(tz).strftime("%d/%m %H:%M")
    print(f"\n📊 {acc.full_label} — {now}   (┃ = onde a barra deveria estar para ficar no ritmo)")
    real = logged_email(acc)
    if real and acc.email and real.lower() != acc.email.lower():
        print(f"   ⚠️  {acc.config_dir} está logado como {real}, não como {acc.email}. Para corrigir: claude-{acc.name}-login")
    print()
    for w in windows:
        flag = "" if w.severity == "normal" else f"  ⚠️ {w.severity}"
        print(f"{w.long_title:<22} {w.percent:>3.0f}% [{bar(w)}]  reseta {fmt_reset(w.resets_at, tz)}{pace_info(w)}{flag}")
    print()
    return True, json_of(windows, None)


# ---- json (orq, orq-web)
def usage_json(acc: Account) -> dict:
    """{'5h': %, '5h_pace': %, '5h_left': s, '7d': ..., '7d_pace': ..., '7d_left': ...} ou {'err': texto}.
    Ritmo 0 e left None = janela não iniciada."""
    return json_of(*get_windows(acc))


def json_of(windows: List[Window], err: Optional[str]) -> dict:
    if err:
        return {"err": err}
    out: Dict[str, object] = {}
    for w in windows:
        k = {"session": "5h", "weekly_all": "7d"}.get(w.kind)
        if not k:
            continue
        out[k] = w.percent
        out[k + "_pace"] = round(w.pace or 0.0, 1)
        out[k + "_left"] = None if w.left is None else max(0, int(w.left))
    return out


# ---- total das contas (semana)
WEEK = WINDOW["weekly_all"]


def total_json(per: Dict[str, dict]) -> Optional[dict]:
    """Consolidado da semana entre as contas (as com erro ficam de fora); None se nenhuma tem 7d.

    Matemática de "error budget" (SLO): a taxa de queima da frota é o consumido dividido pela parte da
    janela já decorrida, somando as contas (1,0 = no ritmo exato das janelas; 2,0 = acaba na metade).
    7d / 7d_pace: usado e ritmo médios; 7d_free: média do que sobra; 7d_free_accounts: o mesmo em contas
    inteiras; 7d_burn: a taxa de queima; 7d_runs_out: segundos até a frota zerar, simulando semana adiante
    com cada conta recarregando no seu reset (None = com os resets, não acaba nos próximos 7 dias);
    7d_next_reset: segundos até o reset semanal mais próximo (e de que conta)."""
    ok = {n: u for n, u in per.items() if not n.startswith("_") and "err" not in u and u.get("7d") is not None}
    if not ok:
        return None
    used = {n: float(u["7d"]) for n, u in ok.items()}
    elapsed = {n: (float(u.get("7d_pace") or 0.0) / 100.0) * WEEK for n, u in ok.items()}  # s decorridos
    rate = {n: (used[n] / elapsed[n] if elapsed[n] > 0 else 0.0) for n in ok}  # pontos/s por conta
    free = sum(100.0 - p for p in used.values())
    burn = (sum(used.values()) / 100.0) / (sum(elapsed.values()) / WEEK) if sum(elapsed.values()) > 0 else 0.0
    resets = sorted((u["7d_left"], n) for n, u in ok.items() if u.get("7d_left"))
    return {
        "accounts": len(ok),
        "7d": round(sum(used.values()) / len(used), 1),
        "7d_pace": round(sum(float(u.get("7d_pace") or 0.0) for u in ok.values()) / len(ok), 1),
        "7d_free": round(free / len(used), 1),
        "7d_free_accounts": round(free / 100.0, 2),
        "7d_burn": round(burn, 2),
        "7d_runs_out": runs_out(used, rate, resets),
        "7d_next_reset": int(resets[0][0]) if resets else None,
        "7d_next_reset_account": resets[0][1] if resets else None,
    }


def runs_out(used: Dict[str, float], rate: Dict[str, float], resets: List[Tuple[float, str]], horizon: float = None) -> Optional[int]:
    """Quando a frota zera, simulando os próximos 7 dias: o consumo total segue na taxa somada (a troca
    automática passa o gasto de uma conta esgotada para as outras) e, no reset de cada conta, o que ela
    tinha gasto volta a ficar disponível. None se não zera dentro do horizonte."""
    horizon = WEEK if horizon is None else horizon
    total_rate = sum(rate.values())
    if total_rate <= 0:
        return None
    free = sum(100.0 - u for u in used.values())
    t = 0.0
    for when, name in [(w, n) for w, n in resets if w <= horizon] + [(horizon, None)]:
        if free - total_rate * (when - t) <= 0:
            return int(t + free / total_rate)
        free -= total_rate * (when - t)
        t = when
        if name is not None:  # a conta recarrega: volta o que gastou até aqui
            free += min(100.0, used[name] + rate[name] * when)
    return None


def visible_len(s: str) -> int:
    return len(re.sub(r"\x1b\[[0-9;]*m", "", s))


def fmt_total(t: Optional[dict], labels: Optional[Dict[str, str]] = None, width: int = 0) -> str:
    """Linha TOTAL só do semanal, centralizada em `width` colunas: barra do usado médio com o ritmo médio;
    à direita, em quanto tempo a frota zera (∞ = com os resets, não zera nesta semana); depois a taxa de
    queima e a média do que sobra nas contas."""
    line = _total_line(t)
    pad = max(0, (width - visible_len(line)) // 2)
    return " " * pad + line


def _total_line(t: Optional[dict]) -> str:
    lab = c("1", "TOTAL")
    if not t:
        return f"{lab} {c('2', 'sem dados')}"
    runs = fmt_left(t["7d_runs_out"]) if t["7d_runs_out"] is not None else c("32", "  ∞  ")
    burn = f"{t['7d_burn']:.1f}".replace(".", ",")
    bcol = "32" if t["7d_burn"] < 0.9 else "33" if t["7d_burn"] <= 1.15 else "31"
    tail = f"queima {c(bcol, burn + '×')} · {t['7d_free']:.0f}% livre"
    return f"{lab}  {cell_of(t['7d'], t['7d_pace'] or None, runs)}  {tail}"


# ======================================================================== cli
def main(argv: Optional[List[str]] = None) -> int:
    ap = argparse.ArgumentParser(prog="usage-all", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-v", "--verbose", action="store_true", help="completo: barra por janela, horário do reset")
    ap.add_argument("--json", action="store_true", help="saída para scripts")
    ap.add_argument("-b", "--brief", action="store_true", help=argparse.SUPPRESS)  # sinônimo antigo do padrão
    ap.add_argument("names", nargs="*", metavar="conta")
    a = ap.parse_args(argv)

    conf = load_conf()
    accounts = {x["name"]: Account.from_conf(x) for x in conf.get("accounts", [])}
    if not accounts:
        die(f"Nenhuma conta em {CONF}.")
    bad = [n for n in a.names if n not in accounts]
    if bad:
        die(f"conta desconhecida: {', '.join(bad)}. Disponíveis: {', '.join(accounts)}")
    chosen = [accounts[n] for n in a.names] if a.names else list(accounts.values())

    if a.json:
        with ThreadPoolExecutor(max_workers=8) as ex:
            per = dict(zip((x.name for x in chosen), ex.map(usage_json, chosen)))
        per["_total"] = total_json(per)  # consolidado da semana (orq-web mostra; quem lê por conta ignora)
        print(json.dumps(per))
        return 0
    if a.verbose:
        tz = timezone(conf)
        results = [show_verbose(x, tz) for x in chosen]
        print(fmt_total(total_json({x.name: r[1] for x, r in zip(chosen, results)}), {x.name: x.label for x in chosen}))
        return 0 if all(r[0] for r in results) else 2
    return 0 if show_brief(chosen) else 2


if __name__ == "__main__":
    sys.exit(main())
