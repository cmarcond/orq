#!/usr/bin/env python3
"""usage-all: Claude Code usage on every account, straight from the OAuth API (~1 s), with a pace marker.

Usage: usage-all [-v|--verbose] [--json] [account ...]    (no account = every account in accounts.json)
  default        brief: one line per account; per window, % used, a mini bar with a pace marker
                 and the time until the reset. Accounts sorted from the most slack to the tightest on 7d;
                 → marks the best one to open now (the one from --melhor); TOTAL = the fleet's week: used,
                 burn (1,0× = on pace), when it runs out (∞ = the resets come first) and the next reset.
  -v, --verbose  full: per account, a wide bar, points above/below the pace, the reset time and a
                 login warning; at the end the TOTAL, the best account and the age of the data.
  --json         for scripts (orq, orq-web): per account, % used, pace and seconds until the 5h and
                 7d resets, or {"err": text}.

█ = used, ┃ = pace (how much of the window has gone by), on the right the time until the reset. A bar
that stops short of the ┃ is below the pace (green); a bar that goes past it is above (yellow; red at 15
points or more). Codex has its own command: codex-usage-fast.

Accounts: ~/.config/claude-multiconta/accounts.json (or $CLAUDE_MULTICONTA_CONF). Credential: Keychain
on macOS (the same item Claude Code uses) or <config_dir>/.credentials.json on Linux. The token is never
printed. Python 3.8+.
"""
import argparse
import datetime
import hashlib
import importlib.machinery
import importlib.util
import json
import re
import os
import pathlib
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple

# ======================================================================== configuration
CONF = pathlib.Path(os.environ.get("CLAUDE_MULTICONTA_CONF", pathlib.Path.home() / ".config/claude-multiconta/accounts.json"))
DEFAULT_DIR = pathlib.Path.home() / ".claude"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
WINDOW = {"session": 5 * 3600, "weekly_all": 7 * 86400, "weekly_scoped": 7 * 86400}  # fixed size of each window


def die(msg: str, code: int = 1) -> None:
    print(msg, file=sys.stderr)
    sys.exit(code)


def load_conf() -> dict:
    try:
        return json.loads(CONF.read_text())
    except Exception as e:  # noqa: BLE001
        die(f"Could not read {CONF} ({e}). Run the claude-multiconta install.sh.")
        return {}


def timezone(conf: dict):
    try:
        import zoneinfo

        return zoneinfo.ZoneInfo(conf.get("timezone") or "America/Sao_Paulo")
    except Exception:  # noqa: BLE001  python < 3.9 or no tzdata: local time zone
        return None


@dataclass
class Account:
    name: str
    config_dir: pathlib.Path
    label: str  # short: "Gmail"
    full_label: str  # as in accounts.json: "Gmail (you@example.com)"
    email: str

    @staticmethod
    def from_conf(a: dict) -> "Account":
        return Account(
            name=a["name"],
            config_dir=pathlib.Path(os.path.expanduser(a.get("config_dir") or "~/.claude")),
            label=(a.get("label") or a["name"]).split(" (")[0],
            full_label=a.get("label") or a["name"],
            email=a.get("email", ""),
        )

    @property
    def is_default(self) -> bool:
        return self.config_dir.resolve() == DEFAULT_DIR.resolve()

    @property
    def state_file(self) -> pathlib.Path:
        """Where Claude Code stores the login: ~/.claude.json for the default account, <dir>/.claude.json for the others."""
        return pathlib.Path.home() / ".claude.json" if self.is_default else self.config_dir / ".claude.json"


# ======================================================================== credential and API
def keychain_service(acc: Account) -> str:
    """Name of the Keychain item: 'Claude Code-credentials' for ~/.claude; the other accounts get the suffix
    of the first 8 hex digits of the sha256 of the absolute path, as Claude Code does."""
    if acc.is_default:
        return "Claude Code-credentials"
    return "Claude Code-credentials-" + hashlib.sha256(str(acc.config_dir).encode()).hexdigest()[:8]


def load_cred(acc: Account) -> Optional[dict]:
    if sys.platform == "darwin":
        r = subprocess.run(["security", "find-generic-password", "-s", keychain_service(acc), "-w"], capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return json.loads(r.stdout.strip())["claudeAiOauth"]
    f = acc.config_dir / ".credentials.json"
    if f.exists():
        return json.loads(f.read_text())["claudeAiOauth"]
    return None


def expired(cred: dict) -> bool:
    return cred.get("expiresAt", 0) / 1000 < datetime.datetime.now().timestamp()


def refresh_cred(acc: Account) -> Optional[dict]:
    """Expired access token (it lasts ~8 h): only Claude Code refreshes it, and only when it calls the API. A
    minimal request to Haiku, without saving a session, forces the refresh; then we read the credential again."""
    claude = shutil.which("claude") or str(pathlib.Path.home() / ".local/bin/claude")
    env = dict(os.environ)
    env.pop("CLAUDE_CONFIG_DIR", None)
    if not acc.is_default:
        env["CLAUDE_CONFIG_DIR"] = str(acc.config_dir)
    try:
        subprocess.run(
            [claude, "-p", "responda apenas: ok", "--model", "haiku", "--no-session-persistence"],
            env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120, cwd=str(pathlib.Path.home()),
        )
    except Exception:  # noqa: BLE001
        return None
    return load_cred(acc)


def fetch_usage(cred: dict) -> dict:
    req = urllib.request.Request(
        USAGE_URL,
        headers={"Authorization": f"Bearer {cred['accessToken']}", "anthropic-beta": "oauth-2025-04-20", "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        return json.load(resp)


def logged_email(acc: Account) -> Optional[str]:
    try:
        return (json.loads(acc.state_file.read_text()).get("oauthAccount") or {}).get("emailAddress")
    except Exception:  # noqa: BLE001
        return None


# ======================================================================== model: usage windows
@dataclass
class Window:
    kind: str  # session | weekly_all | weekly_scoped
    percent: float
    resets_at: Optional[str]  # ISO-8601 or None (window not started yet)
    scope: Optional[str] = None  # model name, in the per-model windows
    severity: str = "normal"

    @property
    def size(self) -> Optional[int]:
        return WINDOW.get(self.kind)

    @property
    def left(self) -> Optional[float]:
        """Seconds until the reset; None if the window has not started."""
        if not self.resets_at:
            return None
        end = datetime.datetime.fromisoformat(self.resets_at.replace("Z", "+00:00"))
        return (end - datetime.datetime.now(datetime.timezone.utc)).total_seconds()

    @property
    def pace(self) -> Optional[float]:
        """% of the window already elapsed: 0 if it has not even started; None if the data is stale or the window is unknown."""
        secs, win = self.left, self.size
        if not win:
            return None
        if secs is None or secs > win:
            return 0.0
        if secs <= 0:
            return None
        return 100 * (1 - secs / win)

    @property
    def title(self) -> str:
        if self.scope:
            return f"{self.scope} 7d"
        return {"session": "session 5h", "weekly_all": "week 7d"}.get(self.kind, self.kind)

    @property
    def slack(self) -> float:
        """Points above (positive) or below (negative) the pace."""
        return self.percent - (self.pace or 0)


ORDER = {"session": 0, "weekly_all": 1, "weekly_scoped": 2}


def parse_windows(data: dict) -> List[Window]:
    limits = data.get("limits") or []
    if not limits:  # old API format
        limits = [
            {"kind": k, "percent": v.get("utilization"), "resets_at": v.get("resets_at")}
            for k, v in data.items()
            if isinstance(v, dict) and v.get("utilization") is not None
        ]
    out = []
    for lim in limits:
        out.append(
            Window(
                kind=lim.get("kind") or "?",
                percent=float(lim.get("percent") or 0),
                resets_at=lim.get("resets_at"),
                scope=((lim.get("scope") or {}).get("model") or {}).get("display_name"),
                severity=lim.get("severity", "normal"),
            )
        )
    return sorted(out, key=lambda w: ORDER.get(w.kind, 9))


# ---- usage-hist database: the collector's last sample, when it is less than 10 min old (no API, no 429)
SNAP: Optional[dict] = None  # {'ts': ISO, 'accounts': {account: {'windows': [...]}}}


def load_snapshot() -> Optional[dict]:
    """Reads the usage-hist database (here, or over ssh on the database machine). None if there is none or it is old."""
    here = pathlib.Path(__file__).resolve().parent / "usage-hist"
    if not here.exists():
        return None
    try:
        loader = importlib.machinery.SourceFileLoader("usage_hist", str(here))
        spec = importlib.util.spec_from_loader("usage_hist", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod.quota_snapshot()
    except Exception:  # noqa: BLE001 - with no database, usage-all goes on through the API
        return None


def from_snapshot(acc: Account) -> Optional[List[Window]]:
    entry = ((SNAP or {}).get("accounts") or {}).get(acc.name)
    if not entry or "windows" not in entry:
        return None
    ws = [Window(kind=w["kind"], percent=float(w["pct"]), resets_at=w.get("resets_at"), scope=w.get("scope") or None, severity=w.get("severity") or "normal") for w in entry["windows"]]
    return sorted(ws, key=lambda w: ORDER.get(w.kind, 9))


STALE_MIN = 15  # minutes: database data older than this gets a note in the brief output


def snap_age_min() -> Optional[int]:
    """Age in minutes of the collection in the database; None when the data came from the API just now."""
    if not SNAP:
        return None
    t = datetime.datetime.fromisoformat(SNAP["ts"].replace("Z", "+00:00"))
    return int((datetime.datetime.now(datetime.timezone.utc) - t).total_seconds() // 60)


def source_note() -> str:
    mins = snap_age_min()
    return "data from the API" if mins is None else f"data from {mins} min ago"


def get_windows(acc: Account, live: bool = False) -> Tuple[List[Window], Optional[str]]:
    """The account's windows, or (None, short error). From the database when there is a recent sample; `live` forces the API."""
    if not live:
        ws = from_snapshot(acc)
        if ws is not None:
            return ws, None
    cred = load_cred(acc)
    if not cred:
        return [], f"no credentials in {acc.config_dir}. Run: claude-{acc.name}-login"
    if expired(cred):
        cred = refresh_cred(acc) or cred
        if expired(cred):
            return [], f"token expired and I could not refresh it. Open `claude-{acc.name}` once or run claude-{acc.name}-login."
    try:
        return parse_windows(fetch_usage(cred)), None
    except urllib.error.HTTPError as e:
        return [], f"API answered {e.code}: {e.read().decode()[:200]}"
    except Exception as e:  # noqa: BLE001
        return [], f"network failure: {e}"


# ======================================================================== output: formatting
COLOR = sys.stdout.isatty()


def c(code: Optional[str], s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if COLOR and code else s


def fmt_left(secs: Optional[float], win: Optional[int] = None) -> str:
    """Time until the reset in 5 columns: 00h45, 04h45, 6d03h. Window not started: the full duration in grey."""
    if secs is None:
        return c("2", fmt_left(win)) if win else "  —  "
    secs = max(0, int(secs))
    d, r = divmod(secs, 86400)
    h, m = divmod(r // 60, 60)
    return f"{d}d{h:02d}h" if d else f"{h:02d}h{m:02d}"


def color_for(percent: float, pace: Optional[float]) -> Optional[str]:
    """Green below the pace, yellow above, red at 15 points or more above; no pace, no colour."""
    if pace is None:
        return None
    d = int(round(percent)) - int(round(pace))
    return "31" if d >= 15 else "33" if d > 0 else "32"


# ---- brief (default): no legend (it is in --help); the arrow marks the best account to open now
LABEL_W, CELL_BAR, SEP = 10, 10, "  "
CELL_W = CELL_BAR + 11  # width of one cell: ' 32% ███████┃░░ 2d02h'


def cell(w: Window) -> str:
    """One window in 21 columns: ' 32% ███████┃░░ 2d02h'. A ┃ inside the bar becomes a notch in the bar's colour."""
    return cell_of(w.percent, w.pace, fmt_left(w.left, w.size))


def cell_of(percent: float, pace: Optional[float], right: str, width: int = CELL_BAR) -> str:
    col = color_for(percent, pace)
    n = int(round(max(0.0, min(100.0, percent)) / 100 * width))
    cells = [c(col, "█")] * n + [c("2", "░")] * (width - n)
    if pace is not None:
        i = min(width - 1, int(pace / 100 * width))
        cells[i] = c(f"1;{col}", "┃") if i < n else c("1", "┃")
    return f"{c(col, f'{int(round(percent)):3d}%')} {''.join(cells)} {right}"


def brief_row(acc: Account) -> Tuple[float, str, List[str], dict]:
    """(sort key, line, titles, json). Key = slack on the all-models weekly window; errors go to the end."""
    windows, err = get_windows(acc)
    lab = f"{acc.label:<{LABEL_W}}"
    if err:
        return float("inf"), f"{lab} ✗ {err}", [], {"err": err}
    weekly = next((w.slack for w in windows if w.kind == "weekly_all"), 999.0)
    return weekly, f"{lab} " + SEP.join(cell(w) for w in windows), [w.title for w in windows], json_of(windows, None)


def show_brief(accounts: List[Account]) -> bool:
    with ThreadPoolExecutor(max_workers=8) as ex:
        rows = list(ex.map(brief_row, accounts))
    titles = max((r[2] for r in rows), key=len, default=[])
    if titles:
        print(c("2", (" " * (LABEL_W + 3) + SEP.join(f"{t:^{CELL_W}}" for t in titles)).rstrip()))
    per = {a.name: r[3] for a, r in zip(accounts, rows)}
    best, _ = best_account(per)
    for a, (_, line, _, _) in sorted(zip(accounts, rows), key=lambda x: x[1][0]):
        if a.name == best:  # the one plain `claude` would open (usage-all --melhor)
            lab = f"{a.label:<{LABEL_W}}"
            print(c("1", "→ " + lab) + line[len(lab):])
        else:
            print("  " + line)
    print()
    print(fmt_total(total_json(per), {a.name: a.label for a in accounts}))
    mins = snap_age_min()
    if mins is not None and mins >= STALE_MIN:
        print(c("2", source_note() + " · --ao-vivo refreshes"))
    return all(r[0] != float("inf") for r in rows)


# ---- full (-v): per account, one line per window with a wide bar, distance from the pace and the reset time
BAR_W = 20


def pace_delta(w: Window) -> str:
    """Points above (+) or below (−) the pace, in the bar's colour; empty with no pace."""
    if not w.pace:
        return "   "
    d = int(round(w.percent)) - int(round(w.pace))
    return c(color_for(w.percent, w.pace), f"{d:+3d}")


def fmt_reset(iso: Optional[str], tz) -> str:
    """Reset time: 'HH:MM' if it is today, otherwise 'dd/mm HH:MM'."""
    if not iso:
        return ""
    t = datetime.datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone(tz)
    return t.strftime("%H:%M" if t.date() == datetime.datetime.now(tz).date() else "%d/%m %H:%M")


def verbose_block(acc: Account, windows: List[Window], err: Optional[str], tz, best: bool) -> List[str]:
    head = f"{'→ ' if best else ''}{acc.label}"
    head = (c("1", head) + "  " + c("2", acc.email)) if acc.email else c("1", head)
    if err:
        return [head, f"  ✗ {err}"]
    out = [head]
    real = logged_email(acc)
    if real and acc.email and real.lower() != acc.email.lower():
        out.append(c("33", f"  ⚠ logged in as {real}; fix: claude-{acc.name}-login"))
    for w in windows:
        flag = c("33", " ⚠") if w.severity != "normal" else ""
        out.append(f"  {w.title:<11}{cell_of(w.percent, w.pace, pace_delta(w), BAR_W)}  {c('2', fmt_reset(w.resets_at, tz))}{flag}")
    return out


def show_verbose(accounts: List[Account], tz) -> bool:
    with ThreadPoolExecutor(max_workers=8) as ex:
        got = list(ex.map(get_windows, accounts))
    per = {a.name: json_of(*g) for a, g in zip(accounts, got)}
    best, _ = best_account(per)
    slack = lambda g: float("inf") if g[1] else next((w.slack for w in g[0] if w.kind == "weekly_all"), 999.0)
    for a, g in sorted(zip(accounts, got), key=lambda x: slack(x[1])):
        print("\n".join(verbose_block(a, g[0], g[1], tz, a.name == best)))
        print()
    labels = {a.name: a.label for a in accounts}
    print(fmt_total(total_json(per), labels))
    r = next((r for r in rank(per) if r["name"] == best), None)
    if r:
        print(f"→ {labels[best]}: {r['free']:.0f} pts expire in {fmt_left(r['left']).strip()}  {c('2', source_note())}")
    else:
        print(c("2", source_note()))
    return all(not g[1] for g in got)


# ---- json (orq, orq-web)
def usage_json(acc: Account) -> dict:
    """{'5h': %, '5h_pace': %, '5h_left': s, '7d': ..., '7d_pace': ..., '7d_left': ...} or {'err': text}.
    Pace 0 and left None = window not started."""
    return json_of(*get_windows(acc))


def json_of(windows: List[Window], err: Optional[str]) -> dict:
    if err:
        return {"err": err}
    out: Dict[str, object] = {}
    for w in windows:
        k = {"session": "5h", "weekly_all": "7d"}.get(w.kind)
        if not k:
            continue
        out[k] = w.percent
        out[k + "_pace"] = round(w.pace or 0.0, 1)
        out[k + "_left"] = None if w.left is None else max(0, int(w.left))
    return out


# ---- total across the accounts (week)
WEEK = WINDOW["weekly_all"]


def total_json(per: Dict[str, dict]) -> Optional[dict]:
    """The week consolidated across the accounts (the ones with an error are left out); None if none has 7d.

    "Error budget" (SLO) maths: the fleet's burn rate is what was consumed divided by the part of the
    window already elapsed, summed over the accounts (1,0 = exactly on the windows' pace; 2,0 = runs out
    halfway). 7d / 7d_pace: average used and pace; 7d_free: average of what is left; 7d_free_accounts: the
    same in whole accounts; 7d_burn: the burn rate; 7d_runs_out: seconds until the fleet runs out, simulating
    the week ahead with each account refilling at its reset (None = with the resets, it does not run out in
    the next 7 days); 7d_next_reset: seconds until the nearest weekly reset (and whose account it is)."""
    ok = {n: u for n, u in per.items() if not n.startswith("_") and "err" not in u and u.get("7d") is not None}
    if not ok:
        return None
    used = {n: float(u["7d"]) for n, u in ok.items()}
    elapsed = {n: (float(u.get("7d_pace") or 0.0) / 100.0) * WEEK for n, u in ok.items()}  # s elapsed
    rate = {n: (used[n] / elapsed[n] if elapsed[n] > 0 else 0.0) for n in ok}  # points/s per account
    free = sum(100.0 - p for p in used.values())
    burn = (sum(used.values()) / 100.0) / (sum(elapsed.values()) / WEEK) if sum(elapsed.values()) > 0 else 0.0
    resets = sorted((u["7d_left"], n) for n, u in ok.items() if u.get("7d_left"))
    return {
        "accounts": len(ok),
        "7d": round(sum(used.values()) / len(used), 1),
        "7d_pace": round(sum(float(u.get("7d_pace") or 0.0) for u in ok.values()) / len(ok), 1),
        "7d_free": round(free / len(used), 1),
        "7d_free_accounts": round(free / 100.0, 2),
        "7d_burn": round(burn, 2),
        "7d_runs_out": runs_out(used, rate, resets),
        "7d_next_reset": int(resets[0][0]) if resets else None,
        "7d_next_reset_account": resets[0][1] if resets else None,
    }


def runs_out(used: Dict[str, float], rate: Dict[str, float], resets: List[Tuple[float, str]], horizon: float = None) -> Optional[int]:
    """When the fleet runs out, simulating the next 7 days: total consumption goes on at the summed rate (the
    automatic switch moves the spending of an exhausted account to the others) and, at each account's reset,
    what it had spent becomes available again. None if it does not run out within the horizon."""
    horizon = WEEK if horizon is None else horizon
    total_rate = sum(rate.values())
    if total_rate <= 0:
        return None
    free = sum(100.0 - u for u in used.values())
    t = 0.0
    for when, name in [(w, n) for w, n in resets if w <= horizon] + [(horizon, None)]:
        if free - total_rate * (when - t) <= 0:
            return int(t + free / total_rate)
        free -= total_rate * (when - t)
        t = when
        if name is not None:  # the account refills: what it spent so far comes back
            free += min(100.0, used[name] + rate[name] * when)
    return None


def visible_len(s: str) -> int:
    return len(re.sub(r"\x1b\[[0-9;]*m", "", s))


def fmt_total(t: Optional[dict], labels: Optional[Dict[str, str]] = None) -> str:
    """The week's TOTAL on one short line: a bar of the average used with the average pace, the burn
    (consumption speed; 1,0× = on pace), when the fleet runs out (∞ = the resets come first) and the next
    weekly reset."""
    lab = c("1", "TOTAL")
    if not t:
        return f"{lab} {c('2', 'no data')}"
    b = t["7d_burn"]
    bcol = "32" if b < 0.9 else "33" if b <= 1.15 else "31"
    burn = c(bcol, f"{b:.1f}×".replace(".", ","))
    runs = c("32", "∞") if t["7d_runs_out"] is None else c("31", fmt_left(t["7d_runs_out"]).strip())
    who = t.get("7d_next_reset_account")
    nxt = f"  reset {(labels or {}).get(who, who)} {fmt_left(t['7d_next_reset']).strip()}" if t.get("7d_next_reset") else ""
    week = cell_of(t["7d"], t["7d_pace"] or None, "").rstrip()
    return f"{lab} {week}  burn {burn}  runs out {runs}{nxt}"


# ======================================================================== the best account to open now
# "Use first what expires first": the quota left on an account close to its weekly reset is gone in hours; the quota
# of an account that only resets days from now stays valid. The order is what is left of the week divided by the hours
# until the reset (points that expire per hour). Guards: a minimum left in the week and the 5 h window far from the limit.
MIN_FREE_7D = 5.0  # points of the week the account must have left to be eligible
MAX_5H = 85.0  # % of the 5 h window above which the account is left out (the session would hit the limit soon)
STAY_5H, STAY_FREE_7D = 70.0, 15.0  # on resume, the conversation's account "is fine" below this and with this much left


def rank(per: Dict[str, dict]) -> List[dict]:
    """Accounts in order of preference, with the reason. `per` is each account's usage_json."""
    out = []
    for name, u in per.items():
        if name.startswith("_"):
            continue
        if "err" in u or u.get("7d") is None:
            out.append({"name": name, "ok": False, "score": -1.0, "free": 0.0, "why": "no quota data"})
            continue
        free = max(0.0, 100.0 - float(u["7d"]))
        h5 = float(u.get("5h") or 0.0)
        left_h = (u.get("7d_left") or WEEK) / 3600.0  # window not started: the whole week ahead
        score = free / max(left_h, 0.5)
        ok, why = True, f"week {u['7d']:.0f}%, {free:.0f} pts left that expire in {fmt_left(left_h * 3600).strip()} ({f'{score:.2f}'.replace('.', ',')} pts/h) · 5h {h5:.0f}%"
        if free < MIN_FREE_7D:
            ok, why = False, f"only {free:.0f} pts left in the week"
        elif h5 >= MAX_5H:
            ok, why = False, f"5 h window at {h5:.0f}%"
        out.append({"name": name, "ok": ok, "score": score, "free": free, "h5": h5, "left": left_h * 3600, "why": why})
    return sorted(out, key=lambda r: (not r["ok"], -r["score"], r.get("h5", 0)))


def best_account(per: Dict[str, dict], stay: Optional[str] = None) -> Tuple[Optional[str], str]:
    """(account, reason). With `stay` (the conversation's account, on resume), stays on it if it is fine."""
    ranked = rank(per)
    if stay:
        cur = next((r for r in ranked if r["name"] == stay), None)
        if cur and cur["ok"] and cur["h5"] < STAY_5H and cur["free"] >= STAY_FREE_7D:
            return stay, "the conversation's account is fine: " + cur["why"]
    ok = [r for r in ranked if r["ok"]]
    if ok:
        return ok[0]["name"], ok[0]["why"]
    usable = sorted((r for r in ranked if r["free"] > 0), key=lambda r: -r["free"])
    if usable:
        return usable[0]["name"], f"no account with slack; the one with the most left ({usable[0]['why']})"
    return None, "no account with quota"


def show_best(accounts: List[Account], stay: Optional[str], verbose: bool) -> int:
    with ThreadPoolExecutor(max_workers=8) as ex:
        per = dict(zip((x.name for x in accounts), ex.map(usage_json, accounts)))
    name, why = best_account(per, stay)
    if verbose:
        labels = {x.name: x.label for x in accounts}
        for r in rank(per):
            mark = "→" if r["name"] == name else " "
            print(f"{mark} {labels.get(r['name'], r['name']):<{LABEL_W}} {'ok  ' if r['ok'] else 'out '}  {r['why']}", file=sys.stderr)
        print(c("2", f"choice: {labels.get(name, name)} · {why} · {source_note()}"), file=sys.stderr)
    elif name and why.startswith("no account"):
        print(f"usage-all: {why}", file=sys.stderr)
    if not name:
        return 2
    print(name)
    return 0


# ======================================================================== cli
def main(argv: Optional[List[str]] = None) -> int:
    ap = argparse.ArgumentParser(prog="usage-all", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-v", "--verbose", action="store_true", help="full: a bar per window, the reset time")
    ap.add_argument("--json", action="store_true", help="output for scripts")
    ap.add_argument("-b", "--brief", action="store_true", help=argparse.SUPPRESS)  # old synonym for the default
    ap.add_argument("--ao-vivo", action="store_true", help="queries the API now, even when the usage-hist database is fresh")
    ap.add_argument("--melhor", action="store_true", help="prints only the best account to open now (what expires first; -v explains)")
    ap.add_argument("--fica", metavar="ACCOUNT", help="with --melhor: stays on this account (the conversation's) if it is fine")
    ap.add_argument("names", nargs="*", metavar="account")
    a = ap.parse_args(argv)

    conf = load_conf()
    accounts = {x["name"]: Account.from_conf(x) for x in conf.get("accounts", [])}
    if not accounts:
        die(f"No account in {CONF}.")
    bad = [n for n in a.names if n not in accounts]
    if bad:
        die(f"unknown account: {', '.join(bad)}. Available: {', '.join(accounts)}")
    chosen = [accounts[n] for n in a.names] if a.names else list(accounts.values())
    global SNAP
    SNAP = None if a.ao_vivo else load_snapshot()

    if a.melhor:
        return show_best(chosen, a.fica, a.verbose)
    if a.json:
        with ThreadPoolExecutor(max_workers=8) as ex:
            per = dict(zip((x.name for x in chosen), ex.map(usage_json, chosen)))
        per["_total"] = total_json(per)  # the week consolidated (orq-web shows it; per-account readers ignore it)
        per["_fonte"] = {"banco": SNAP["ts"]} if SNAP else {"api": True}
        print(json.dumps(per))
        return 0
    if a.verbose:
        return 0 if show_verbose(chosen, timezone(conf)) else 2
    ok = show_brief(chosen)
    return 0 if ok else 2


if __name__ == "__main__":
    sys.exit(main())
