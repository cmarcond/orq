#!/bin/sh
# Used as $BROWSER in `claude auth login`: it does NOT open any browser, it only shows
# the URL. Open it in whichever browser you like, logged in to the right account (or in
# a private window), and paste the code back into the terminal.
printf '\n>>> Open this URL logged in to the right account (or in a private window) and paste the code here:\n\n    %s\n\n' "$1" >&2
exit 0
